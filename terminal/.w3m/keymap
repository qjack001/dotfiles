# help: `?`
# exit: `q`

# history: `esc+h`
# inspect source: `esc+i`
# show links: `esc+l`
# settings: `esc+s`

# go back: `delete`
# open page in browser: `o`
# follow link: `enter`
# open link in new tab: `alt+enter`
# open link in browser: `alt+o`
# close tab: `w`
# move to prev tab: `[`
# move to next tab: `]`

# focus next link: `tab`
# focus prev link: `alt+tab`
# screenshot: `ctrl-s`	
# reload: `ctrl-r`


